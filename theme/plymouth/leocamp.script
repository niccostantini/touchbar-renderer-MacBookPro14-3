# Leo Camp boot splash. Pieces are pre-rendered by build.py; geometry is in
# the scene's native 1920x1200 pixels and scaled to the screen.

FORMULAS = 20;
NAMES = 20;

Window.SetBackgroundTopColor(0.071, 0.051, 0.086);
Window.SetBackgroundBottomColor(0.071, 0.051, 0.086);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

scene = Image("background.png");
k = Math.Max(screen_w / scene.GetWidth(), screen_h / scene.GetHeight());

fun place_x(native_x) { return screen_w / 2 + (native_x - 960) * k; }
fun place_y(native_y) { return screen_h / 2 + (native_y - 600) * k; }

fun scaled(image) {
  return image.Scale(Math.Max(1, image.GetWidth() * k), Math.Max(1, image.GetHeight() * k));
}

scene_sprite = Sprite(scaled(scene));
scene_sprite.SetX(place_x(0));
scene_sprite.SetY(place_y(0));
scene_sprite.SetZ(-10);

# ---- Random greeting: "<formula> <name><punctuation>" ----
formula = Math.Int(Math.Random() * FORMULAS) + 1;
if (formula > FORMULAS) formula = FORMULAS;
name = Math.Int(Math.Random() * NAMES) + 1;
if (name > NAMES) name = NAMES;
if (Math.Random() < 0.5) name_file = "n" + name + "s.png";
else name_file = "n" + name + ".png";

prefix = scaled(Image("f" + formula + ".png"));
who = scaled(Image(name_file));
suffix = scaled(Image("p" + formula + ".png"));

space = 18 * k;
total = prefix.GetWidth() + space + who.GetWidth() + suffix.GetWidth();
text_x = screen_w / 2 - total / 2;
text_y = place_y(855);

prefix_sprite = Sprite(prefix);
prefix_sprite.SetPosition(text_x, text_y, 1);
who_sprite = Sprite(who);
who_sprite.SetPosition(text_x + prefix.GetWidth() + space, text_y, 1);
suffix_sprite = Sprite(suffix);
suffix_sprite.SetPosition(text_x + prefix.GetWidth() + space + who.GetWidth(), text_y, 1);

# ---- Progress bar ----
bar = scaled(Image("bar.png"));
bar_sprite = Sprite(bar);
bar_sprite.SetPosition(place_x(700), place_y(1030), 1);

fill_image = Image("fill.png");
fill_sprite = Sprite();
fill_sprite.SetPosition(place_x(706), place_y(1036), 2);

fun progress_callback(duration, progress) {
  width = Math.Max(1, fill_image.GetWidth() * k * progress);
  fill_sprite.SetImage(fill_image.Scale(width, fill_image.GetHeight() * k));
}
Plymouth.SetBootProgressFunction(progress_callback);
